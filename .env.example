# Copy to .env and fill in the two Telegram values. Every other line is optional and
# shows the built-in default. Real environment variables win over this file.
# Lines marked "live" can also be changed at runtime with /set <key> <value>; those
# overrides are stored in data/preferences.json and win over .env until /settings reset.

# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Chats that receive alerts, comma separated. Send /start to the bot to learn your chat id.
TELEGRAM_CHAT_IDS=123456789
# Chats allowed to control the bot. Empty = every chat may issue commands (see SECURITY.md).
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Monitoring ──────────────────────────────────────────────────────────────
# Seconds between two rounds of one site, random within this range (live: poll_interval_min/max).
# A round itself takes about 2 s; below 3 s most sites start rate-limiting.
POLL_INTERVAL_MIN=4
POLL_INTERVAL_MAX=10
# Browser tabs rendering at the same time (all sites and turbo together)
MAX_CONCURRENT_PAGES=8
# Seconds: hard limit for the initial document, cap on the wait for network idle,
# extra settle time after that (live: network_idle_timeout, settle_delay).
# Measured: pages go idle in about 0.8 s; a page that never goes idle costs the full cap.
PAGE_LOAD_TIMEOUT=20
NETWORK_IDLE_TIMEOUT=2
SETTLE_DELAY=0.25
# Load timeouts in a row that flag a page: one alert, its timeout is doubled (up to 3x);
# 0 = off (live: render_failure_threshold)
RENDER_FAILURE_THRESHOLD=5
# Seconds between the two renders that confirm a change (live: confirm_delay)
CONFIRM_DELAY=2
# New confirmed contracts on one page that trigger the auto-pause (live: contract_pause_threshold)
CONTRACT_PAUSE_THRESHOLD=5
# Sub-pages derived from every root URL ({domain} is the host without "www.")
SUB_URL_PATTERNS=https://app.{domain},https://app.{domain}/leaderboard,https://{domain}/dashboard,https://docs.{domain},https://{domain}/app,https://doc.{domain},https://{domain}/create
# HTML attributes never compared (comma separated)
IGNORED_ATTRIBUTES=nonce,integrity,csrf-token,data-csrf,data-csrf-token,data-nonce,data-timestamp,data-reactid,data-react-checksum
# Examples of changed elements quoted in a change alert; 0 = counts only (live: max_change_examples)
MAX_CHANGE_EXAMPLES=5
# Seconds a contract alert may wait for token details (name, supply, DEX pair); 0 = links only
# (live: enrich_timeout; measured 0.05-0.2 s on the public nodes and DexScreener)
ENRICH_TIMEOUT=2
# Silence an element after it alerted FLAP_THRESHOLD times within FLAP_WINDOW_HOURS;
# 0 hours = off (live: flap_window_hours, flap_threshold)
FLAP_WINDOW_HOURS=24
FLAP_THRESHOLD=2
# Also search iframes, shadow DOM and the scripts/JSON the page loaded, no extra requests
# (live: deep_scan); byte budget per render (5 MB of JS take about 0.8 s to scan)
DEEP_SCAN=true
DEEP_SCAN_MAX_MB=5

# ── Turbo mode (/turbo <url>) and blocking ───────────────────────────────────
# Seconds between full renders in turbo mode, min 1 (live: turbo_interval);
# default and maximum session length in minutes (live: turbo_default_minutes, turbo_max_minutes)
TURBO_INTERVAL=2
TURBO_DEFAULT_MINUTES=30
TURBO_MAX_MINUTES=180
# Confirmed contracts that end a session; 0 = only the timer or /turbo stop (live: turbo_stop_after)
TURBO_STOP_AFTER=1
# Sites in turbo at once, pages rendered per cycle (root included), seconds between on-chain
# re-checks of unverified addresses (live: turbo_max_sites, turbo_max_pages, turbo_recheck_interval)
TURBO_MAX_SITES=1
TURBO_MAX_PAGES=4
TURBO_RECHECK_INTERVAL=5
# Longest pause between rounds while a site looks like it blocks us; the interval doubles
# per blocked round up to this value (live: block_max_backoff)
BLOCK_MAX_BACKOFF=600

# ── Unverified mode (/unverified <url> on) ───────────────────────────────────
# Re-check announced addresses on-chain every N minutes, for how many hours, and the
# alert cap per hour and site (live: unverified_recheck_minutes, unverified_watch_hours,
# unverified_max_per_hour)
UNVERIFIED_RECHECK_MINUTES=5
UNVERIFIED_WATCH_HOURS=24
UNVERIFIED_MAX_PER_HOUR=10

# ── Browser ─────────────────────────────────────────────────────────────────
# chromium (bundled, run `playwright install chromium` once) or chrome / msedge (installed browser)
BROWSER_CHANNEL=chromium
HEADLESS=true
# Resource types the browser does not download (speeds up rendering)
BLOCKED_RESOURCE_TYPES=image,media,font

# ── Blockchain RPC ──────────────────────────────────────────────────────────
# Set an EVM endpoint to an empty value to skip that network. All endpoints are public
# nodes; use your own if privacy or rate limits matter.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARB_RPC_URL=https://arbitrum-one-rpc.publicnode.com
OPT_RPC_URL=https://optimism-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
FANTOM_RPC_URL=https://rpcapi.fantom.network
SONIC_RPC_URL=https://rpc.soniclabs.com
AVAX_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SUI_RPC_URL=https://sui-rpc.publicnode.com
# Only count EVM contracts that answer ERC-20 calls (totalSupply/symbol/decimals) (live: require_erc20)
REQUIRE_ERC20=true
# Seconds per RPC call (measured: every public node answers in 0.05-0.3 s) and concurrent address checks
RPC_TIMEOUT=5
MAX_CONCURRENT_RPC=8
# Hours before a rejected address is checked again; 0 = never (live: rejected_ttl_hours)
REJECTED_TTL_HOURS=6
# Seconds before an address whose RPC check failed is retried
RPC_RETRY_DELAY=600

# ── Misc ────────────────────────────────────────────────────────────────────
DATA_DIR=data
LOG_LEVEL=INFO
# Optional rotating log file (5 MB x 3); empty = console only
LOG_FILE=
# Seconds between heartbeat writes to data/heartbeat (rebooter.py restarts the bot when it goes stale)
HEARTBEAT_INTERVAL=15
