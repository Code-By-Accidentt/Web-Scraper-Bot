# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Chats that receive alerts, comma separated. Send /start to the bot to learn your chat id.
TELEGRAM_CHAT_IDS=123456789
# Chats allowed to control the bot. Empty = every chat may issue commands.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Monitoring ──────────────────────────────────────────────────────────────
# Seconds to wait between two rounds of one site (a random value in this range)
POLL_INTERVAL_MIN=5
POLL_INTERVAL_MAX=15
# Pages rendered in the browser at the same time
MAX_CONCURRENT_PAGES=6
# Seconds: hard limit for the initial document, wait for network idle, extra settle time
PAGE_LOAD_TIMEOUT=30
NETWORK_IDLE_TIMEOUT=4
SETTLE_DELAY=0.5
# Seconds between the two fetches that confirm a change
CONFIRM_DELAY=2
# Number of new confirmed contracts on one page that triggers the auto-pause
CONTRACT_PAUSE_THRESHOLD=5
# Sub-pages derived from every root URL ({domain} is the host without "www.")
SUB_URL_PATTERNS=https://app.{domain},https://app.{domain}/leaderboard,https://{domain}/dashboard,https://docs.{domain},https://{domain}/app,https://doc.{domain},https://{domain}/create
# HTML attributes never compared (comma separated)
IGNORED_ATTRIBUTES=nonce,integrity,csrf-token,data-csrf,data-csrf-token,data-nonce,data-timestamp,data-reactid,data-react-checksum
# Examples of changed elements included in a change alert
MAX_CHANGE_EXAMPLES=5
# Silence an element after it changed FLAP_THRESHOLD times within FLAP_WINDOW_HOURS (0 = off)
FLAP_WINDOW_HOURS=24
FLAP_THRESHOLD=2
# Also search iframes, shadow DOM and the scripts/JSON the page loaded (no extra requests)
DEEP_SCAN=true
DEEP_SCAN_MAX_MB=10

# ── Turbo mode (/turbo <url>) and blocking ───────────────────────────────────
# Seconds between full renders in turbo mode (min 1); default and maximum session length
TURBO_INTERVAL=2
TURBO_DEFAULT_MINUTES=30
TURBO_MAX_MINUTES=180
# Confirmed contracts that end a turbo session (0 = only the timer or /turbo stop)
TURBO_STOP_AFTER=1
# Sites in turbo at the same time, pages rendered per cycle (root included), on-chain re-check of unverified addresses
TURBO_MAX_SITES=1
TURBO_MAX_PAGES=4
TURBO_RECHECK_INTERVAL=5
# Longest pause between rounds while a site looks like it blocks us (interval doubles per round)
BLOCK_MAX_BACKOFF=600

# ── Browser ─────────────────────────────────────────────────────────────────
# chromium (bundled, run `playwright install chromium` once) or chrome / msedge (installed browser)
BROWSER_CHANNEL=chromium
HEADLESS=true
# Resource types the browser does not download (speeds up rendering)
BLOCKED_RESOURCE_TYPES=image,media,font

# ── Blockchain RPC ──────────────────────────────────────────────────────────
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARB_RPC_URL=https://arbitrum-one-rpc.publicnode.com
OPT_RPC_URL=https://optimism-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
FANTOM_RPC_URL=https://rpcapi.fantom.network
SONIC_RPC_URL=https://rpc.soniclabs.com
AVAX_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Only count EVM contracts that answer ERC-20 calls (totalSupply/symbol/decimals)
REQUIRE_ERC20=true
RPC_TIMEOUT=8
MAX_CONCURRENT_RPC=8
# Hours before a rejected address is checked again (0 = never re-check)
REJECTED_TTL_HOURS=6
# Seconds before an address whose RPC check failed is retried
RPC_RETRY_DELAY=600

# ── Misc ────────────────────────────────────────────────────────────────────
DATA_DIR=data
LOG_LEVEL=INFO
# Optional rotating log file (empty = console only)
LOG_FILE=
HEARTBEAT_INTERVAL=15
