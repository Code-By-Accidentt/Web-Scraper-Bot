# Put the two Telegram values into .env, plus only the lines you want to differ from the
# default: a whole copy pins today's defaults (the bot warns at start when a default it
# pins has changed). Every other line shows the built-in default. Real environment
# variables win over .env.
# Lines marked "live" can also be changed at runtime with /set <key> <value>; those
# overrides are stored in data/preferences.json and win over .env until /settings reset.

# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Chats that receive alerts, comma separated. Send /start to the bot to learn your chat id.
TELEGRAM_CHAT_IDS=123456789
# Chats allowed to control the bot. Empty = the chats in TELEGRAM_CHAT_IDS (see SECURITY.md).
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Monitoring ──────────────────────────────────────────────────────────────
# Seconds between two rounds of one site, random within this range (live: poll_interval_min/max).
# A round itself takes about 2 s; below 3 s most sites start rate-limiting.
POLL_INTERVAL_MIN=4
POLL_INTERVAL_MAX=10
# Browser tabs rendering at the same time (all sites and turbo together)
MAX_CONCURRENT_PAGES=8
# Seconds: hard limit for the initial document, cap on the wait for network idle,
# extra settle time after that (live: network_idle_timeout, settle_delay).
# Measured: pages go idle in about 0.8 s; a page that never goes idle costs the full cap.
PAGE_LOAD_TIMEOUT=20
NETWORK_IDLE_TIMEOUT=2
SETTLE_DELAY=0.25
# Load timeouts in a row that flag a page: one alert, its timeout is doubled (up to 3x);
# 0 = off (live: render_failure_threshold)
RENDER_FAILURE_THRESHOLD=5
# Seconds between the two renders that confirm a change (live: confirm_delay)
CONFIRM_DELAY=2
# Light mode: between renders every page's HTML and the site's own JSON APIs are asked over
# plain HTTP this often (mostly a 304 without a body); a new address there is announced at
# once. 0 = off (live: light_interval). The pace while turbo runs for the site, min 0.1
# (live: light_turbo_interval). A page whose HTML shows what its render shows, and that
# neither ticks nor polls on its own, is fully rendered only every RENDER_INTERVAL
# seconds, min 4 (live: render_interval)
LIGHT_INTERVAL=1
LIGHT_TURBO_INTERVAL=0.3
RENDER_INTERVAL=30
# New confirmed contracts on one page that trigger the auto-pause (live: contract_pause_threshold)
CONTRACT_PAUSE_THRESHOLD=5
# Sub-pages derived from every root URL ({domain} is the host without "www.")
SUB_URL_PATTERNS=https://app.{domain},https://app.{domain}/leaderboard,https://{domain}/dashboard,https://docs.{domain},https://{domain}/app,https://doc.{domain},https://{domain}/create
# HTML attributes never compared (comma separated)
IGNORED_ATTRIBUTES=nonce,integrity,csrf-token,data-csrf,data-csrf-token,data-nonce,data-timestamp,data-reactid,data-react-checksum
# Examples of changed elements quoted in a change alert; 0 = counts only (live: max_change_examples)
MAX_CHANGE_EXAMPLES=5
# Seconds spent on token details (name, supply, authorities, age, DEX pair), edited into a
# token alert after it went out; the alert never waits. 0 = links only
# (live: enrich_timeout; measured 0.05-0.3 s on the public nodes and DexScreener)
ENRICH_TIMEOUT=2
# Silence an element after it alerted FLAP_THRESHOLD times within FLAP_WINDOW_HOURS;
# 0 hours = off (live: flap_window_hours, flap_threshold)
FLAP_WINDOW_HOURS=24
FLAP_THRESHOLD=2
# Also search iframes, shadow DOM and the scripts/JSON the page loaded, no extra requests
# (live: deep_scan). Off by default: wallet kits ship dozens of token addresses in their
# bundles. When on, what a page's scripts carry on its first round is ignored until the
# page itself shows it; a body over 3 MB is skipped. Byte budget per render (5 MB of JS
# take about 0.8 s to scan)
DEEP_SCAN=false
DEEP_SCAN_MAX_MB=5

# ── Turbo mode (/turbo <url>) and blocking ───────────────────────────────────
# Seconds between full renders in turbo mode, min 1 (live: turbo_interval);
# default and maximum session length in minutes (live: turbo_default_minutes, turbo_max_minutes)
TURBO_INTERVAL=2
TURBO_DEFAULT_MINUTES=30
TURBO_MAX_MINUTES=180
# Confirmed contracts that end a session; 0 = only the timer or /turbo stop (live: turbo_stop_after)
TURBO_STOP_AFTER=1
# Sites in turbo at once, pages rendered per cycle (root included), seconds between on-chain
# checks of a turbo site's addresses that are not a token yet
# (live: turbo_max_sites, turbo_max_pages, turbo_recheck_interval)
TURBO_MAX_SITES=1
TURBO_MAX_PAGES=4
TURBO_RECHECK_INTERVAL=1
# Longest pause between rounds while a site looks like it blocks us; the interval doubles
# per blocked round up to this value, a longer Retry-After from the site is honoured
# (live: block_max_backoff)
BLOCK_MAX_BACKOFF=600
# Auto-turbo: when a page shows a launch time (a countdown with launch words next to it, a
# date with its time zone, a countdown target in its scripts) or a phrase such as "CA: soon"
# or "presale is live" appears on it, the site is checked faster from AUTO_TURBO_BEFORE_MINUTES
# before that time to AUTO_TURBO_AFTER_MINUTES after it, or until its first token: rounds every
# TURBO_INTERVAL, light polls every LIGHT_TURBO_INTERVAL, its addresses every
# TURBO_RECHECK_INTERVAL. At most AUTO_TURBO_MAX_SITES sites at once; /turbo stop <url> ends it
# (live: auto_turbo, auto_turbo_before_minutes, auto_turbo_after_minutes, auto_turbo_max_sites)
AUTO_TURBO=true
AUTO_TURBO_BEFORE_MINUTES=10
AUTO_TURBO_AFTER_MINUTES=60
AUTO_TURBO_MAX_SITES=3

# ── Unverified mode (/unverified <url> on) ───────────────────────────────────
# Re-check announced addresses on-chain every N minutes, for how many hours, and the
# alert cap per hour and site (live: unverified_recheck_minutes, unverified_watch_hours,
# unverified_max_per_hour)
UNVERIFIED_RECHECK_MINUTES=5
UNVERIFIED_WATCH_HOURS=24
UNVERIFIED_MAX_PER_HOUR=10

# ── Browser ─────────────────────────────────────────────────────────────────
# chromium (bundled, run `playwright install chromium` once) or chrome / msedge (installed browser)
BROWSER_CHANNEL=chromium
HEADLESS=true
# Resource types the browser does not download (speeds up rendering). Next.js prefetches
# and analytics beacons are always dropped.
BLOCKED_RESOURCE_TYPES=image,media,font
# Extra Chromium switches, split like a shell does. The default turns 3D off: without a
# GPU, WebGL is drawn by the CPU. An empty value passes no switches. Chromium runs with its
# sandbox unless --no-sandbox is given (where it cannot start, the bot runs without it).
BROWSER_ARGS=--disable-3d-apis --disable-webgl --disable-webgl2
# Read pages like a browser a person runs: the User-Agent without "Headless" (the HTTP
# clients send the same one), navigator.webdriver false, one language (en-US), and cookies
# kept in data/browser_state.json across restarts, so a passed Cloudflare or Vercel check
# is not asked again. No captcha solving, no proxies. false = the browser's own defaults.
HIDE_AUTOMATION=true

# ── Blockchain RPC ──────────────────────────────────────────────────────────
# Set an EVM endpoint to an empty value to skip that network. All endpoints are public
# nodes; use your own if privacy or rate limits matter.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARB_RPC_URL=https://arbitrum-one-rpc.publicnode.com
OPT_RPC_URL=https://optimism-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
FANTOM_RPC_URL=https://rpcapi.fantom.network
SONIC_RPC_URL=https://rpc.soniclabs.com
AVAX_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
# Optional networks: when their endpoint fails, the other networks still decide, and an
# address with no code yet is re-checked on them by the pending watch.
# Circle's Arc (chain 5042; the official rpc.mainnet.arc.io refuses calls without a key)
ARC_RPC_URL=https://arc-rpc.publicnode.com
# Robinhood Chain (chain 4663)
ROBINHOOD_RPC_URL=https://robinhood-rpc.publicnode.com
# api.mainnet-beta.solana.com answered 60 of 100 parallel calls with HTTP 429; publicnode all 100
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
SUI_RPC_URL=https://sui-rpc.publicnode.com
# RPC and Telegram over HTTP/2 (parallel calls share one warm connection); false = HTTP/1.1
HTTP2=true
# Only count EVM contracts that answer totalSupply and decimals and are not LP pairs or vaults
# (live: require_erc20)
REQUIRE_ERC20=true
# Skip tokens whose symbol is a stablecoin's or a wrapped or staked coin's (USDC, WETH,
# stETH, ...) at an address not on the stop-list: bridged copies and fakes, never a launch.
# Judged per network; on EVM and Sui only with REQUIRE_ERC20 on (live: skip_stable_copies)
SKIP_STABLE_COPIES=true
# Seconds per RPC call (measured: every public node answers in 0.05-0.3 s) and concurrent address checks
RPC_TIMEOUT=5
MAX_CONCURRENT_RPC=8
# Hours before a rejected address is checked again; 0 = never (live: rejected_ttl_hours)
REJECTED_TTL_HOURS=6
# Seconds before an address whose RPC check failed is checked again (quick failures such as
# HTTP 429 are also retried within the call); when only an optional network did not answer,
# that network alone is asked again. A failing endpoint is reported once, after 5 minutes
RPC_RETRY_DELAY=10

# ── Misc ────────────────────────────────────────────────────────────────────
DATA_DIR=data
LOG_LEVEL=INFO
# Optional rotating log file (5 MB x 3); empty = console only
LOG_FILE=
# Seconds between heartbeat writes to data/heartbeat (rebooter.py restarts the bot when it goes stale)
HEARTBEAT_INTERVAL=15
